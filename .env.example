# Token du bot Discord (Developer Portal > Bot > Token)
DISCORD_TOKEN=your_bot_token_here

# ID de l'application (Developer Portal > General Information > Application ID)
CLIENT_ID=your_client_id_here

# (Optionnel) ID du serveur pour enregistrer les commandes en dev (instantané)
GUILD_ID=your_guild_id_here

# (Optionnel) Salon de logs (défaut : 1396210242022539468)
LOG_CHANNEL_ID=1396210242022539468

# (Optionnel) Salon de bienvenue (image générée avec l'avatar)
WELCOME_CHANNEL_ID=512447311599632406

# (Optionnel) Salon d'annonce de montée de niveau (défaut : 1398594760427438230)
LEVEL_UP_CHANNEL_ID=1398594760427438230

# (Optionnel) Salon où poster le changelog après une mise à jour (défaut : 1369717395811336212)
CHANGELOG_CHANNEL_ID=1369717395811336212

# Annonces de live Twitch (à créer sur https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
# Chaînes à surveiller, séparées par des virgules (logins Twitch, sans le https://)
TWITCH_CHANNELS=kekos_yt

# (Optionnel) Salon d'annonce des lives (défaut : 1369717395811336212)
LIVE_CHANNEL_ID=1369717395811336212
# (Optionnel) Intervalle de vérification en ms (défaut : 120000 = 2 min, minimum 30000)
LIVE_POLL_INTERVAL_MS=120000

# XP passif en vocal (défaut : +10 XP toutes les 1 min)
VOICE_XP_PER_TICK=10
# Intervalle en ms (défaut : 60000 = 1 min, minimum 10000)
VOICE_XP_TICK_MS=60000
# (Optionnel) Mettre à false pour donner de l'XP même aux membres mutés / sourds
VOICE_XP_IGNORE_MUTED=true
VOICE_XP_IGNORE_DEAFENED=true
