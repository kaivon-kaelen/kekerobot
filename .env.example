# Token du bot Discord (Developer Portal > Bot > Token)
DISCORD_TOKEN=your_bot_token_here

# ID de l'application (Developer Portal > General Information > Application ID)
CLIENT_ID=your_client_id_here

# (Optionnel) ID du serveur pour enregistrer les commandes en dev (instantané)
GUILD_ID=your_guild_id_here

# (Optionnel) Salon de logs (défaut : 1396210242022539468)
LOG_CHANNEL_ID=1396210242022539468

# (Optionnel) Salon de bienvenue (image générée avec l'avatar)
WELCOME_CHANNEL_ID=512447311599632406

# (Optionnel) Salon d'annonce de montée de niveau (défaut : 1398594760427438230)
LEVEL_UP_CHANNEL_ID=1398594760427438230

# (Optionnel) Salon où poster le changelog après une mise à jour (défaut : 1369717395811336212)
CHANGELOG_CHANNEL_ID=1369717395811336212
